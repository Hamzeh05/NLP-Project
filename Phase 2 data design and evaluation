    "import pandas as pd\n",
    "import json\n",
    "\n",
    "jsonl_path = r'C:\\Users\\hamze\\Downloads\\SumArabic\\SumArabic\\sumarabic-1.0-train.jsonl'\n",
    "rows = []\n",
    "\n",
    "try:\n",
    "    with open(jsonl_path, 'r', encoding='utf-8') as f:\n",
    "        for line in f:\n",
    "            try:\n",
    "                rec = json.loads(line)\n",
    "                if rec.get('text') and rec.get('headline'):\n",
    "                    rows.append({\n",
    "                        'document': rec['text'].strip(),\n",
    "                        'summary':  rec['headline'].strip(),\n",
    "                        'source':   rec.get('subdomain', '')\n",
    "                    })\n",
    "            except json.JSONDecodeError:\n",
    "                continue\n",
    "\n",
    "    df_sumarabic = pd.DataFrame(rows)\n",
    "\n",
    "    if not df_sumarabic.empty:\n",
    "        df_sumarabic = df_sumarabic[(df_sumarabic['document'] != '') & (df_sumarabic['summary'] != '')]\n",
