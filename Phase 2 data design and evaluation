    "\n",
    "encoder = nn.Sequential()\n",
    "encoder.embedding = nn.Embedding(VOCAB_SIZE, EMBEDDING_DIM, padding_idx=0).to(device)\n",
    "encoder.lstm      = nn.LSTM(EMBEDDING_DIM, LATENT_DIM, batch_first=True, bidirectional=True, dropout=0.3).to(device)\n",
    "\n",
    "shared_emb = encoder.embedding\n",
    "\n",
    "class Encoder(nn.Module):\n",
    "    def __init__(self):\n",
    "        super().__init__()\n",
    "        self.embedding = shared_emb\n",
    "        self.lstm      = nn.LSTM(EMBEDDING_DIM, LATENT_DIM, batch_first=True, bidirectional=True, dropout=0.3)\n",
    "    def forward(self, x):\n",
    "        emb = self.embedding(x)\n",
    "        outputs, (h, c) = self.lstm(emb)\n",
    "        h = torch.cat([h[0], h[1]], dim=1)\n",
    "        c = torch.cat([c[0], c[1]], dim=1)\n",
    "        return outputs, h, c\n",
    "\n",
    "class BahdanauAttention(nn.Module):\n",
    "    def __init__(self):\n",
    "        super().__init__()\n",
    "        self.W1 = nn.Linear(LATENT_DIM * 2, LATENT_DIM * 2)\n",
    "        self.W2 = nn.Linear(LATENT_DIM * 2, LATENT_DIM * 2)\n",
    "        self.V  = nn.Linear(LATENT_DIM * 2, 1)\n",
    "    def forward(self, decoder_hidden, encoder_outputs):\n",
    "        dh      = decoder_hidden.unsqueeze(1)\n",
    "        score   = self.V(torch.tanh(self.W1(encoder_outputs) + self.W2(dh)))\n",
    "        weights = torch.softmax(score, dim=1)\n",
    "        context = (weights * encoder_outputs).sum(dim=1)\n",
    "        return context\n",
    "\n",
    "class Decoder(nn.Module):\n",
    "    def __init__(self):\n",
    "        super().__init__()\n",
    "        self.embedding = shared_emb\n",
    "        self.lstm      = nn.LSTM(EMBEDDING_DIM + LATENT_DIM * 2, LATENT_DIM * 2, batch_first=True, dropout=0.3)\n",
    "        self.attention = BahdanauAttention()\n",
    "        self.fc        = nn.Linear(LATENT_DIM * 4, VOCAB_SIZE)\n",
    "    def forward(self, x, h, c, encoder_outputs):\n",
    "        emb     = self.embedding(x)\n",
    "        context = self.attention(h.squeeze(0), encoder_outputs).unsqueeze(1)\n",
    "        out, (h, c) = self.lstm(torch.cat([emb, context], dim=2), (h, c))\n",
    "        pred    = self.fc(torch.cat([out.squeeze(1), context.squeeze(1)], dim=1))\n",
    "        return pred, h, c\n",
    "\n",
    "class Seq2Seq(nn.Module):\n",
    "    def __init__(self):\n",
    "        super().__init__()\n",
    "        self.encoder = Encoder()\n",
    "        self.decoder = Decoder()\n",
    "    def forward(self, src, trg):\n",
    "        enc_out, h, c = self.encoder(src)\n",
    "        h = h.unsqueeze(0)\n",
    "        c = c.unsqueeze(0)\n",
    "        outputs = torch.zeros(src.shape[0], trg.shape[1], VOCAB_SIZE).to(device)\n",
    "        inp = trg[:, 0].unsqueeze(1)\n",
    "        for t in range(trg.shape[1]):\n",
    "            pred, h, c = self.decoder(inp, h, c, enc_out)\n",
    "            outputs[:, t, :] = pred\n",
    "            inp = trg[:, t].unsqueeze(1)\n",
    "        return outputs\n",
    "\n",
